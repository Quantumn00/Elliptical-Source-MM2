-- Appended Combat Bomb Feature
-- Adds a simple combat tab "Create Bomb" UI and keybind that fires the player's FakeBomb remote aimed at their feet
-- When a bomb lands near the player's feet this triggers a jump + double-jump to simulate knockback reaction.

-- CombatBombFeature (appended)
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local DEFAULT_BIND = "G" -- default keybind
local BOMB_DETECT_DURATION = 6 -- seconds
local BOMB_DETECT_DISTANCE = 6 -- studs
local DOUBLE_JUMP_DELAY = 0.12

local function getCharacter()
    return LocalPlayer and LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHumanoid()
    local char = getCharacter()
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getHRP()
    local char = getCharacter()
    return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
end

local function getBombRemote()
    local char = getCharacter()
    if not char then return nil end
    local fb = char:FindFirstChild("FakeBomb")
    if fb then
        local ev = fb:FindFirstChild("RemoteEvent") or fb:FindFirstChildWhichIsA("RemoteEvent")
        if ev then return ev, fb end
    end
    return nil, nil
end

local function triggerDoubleJump()
    local humanoid = getHumanoid()
    if not humanoid then return end
    humanoid.Jump = true
    task.delay(DOUBLE_JUMP_DELAY, function()
        if humanoid and humanoid.Health > 0 then
            humanoid.Jump = true
        end
    end)
end

local function watchForBombHit(hrp, duration)
    if not hrp then return end
    local start = tick()
    local matched = false
    while tick() - start < duration do
        for _, desc in ipairs(workspace:GetDescendants()) do
            if desc and desc:IsA("BasePart") then
                local name = desc.Name and desc.Name:lower() or ""
                if string.find(name, "bomb") or string.find(name, "fakebomb") then
                    local dist = (desc.Position - hrp.Position).Magnitude
                    if dist <= BOMB_DETECT_DISTANCE then
                        matched = true
                        break
                    end
                end
            elseif desc and desc:IsA("Model") then
                local name = desc.Name and desc.Name:lower() or ""
                if string.find(name, "bomb") or string.find(name, "fakebomb") then
                    local primary = desc.PrimaryPart or desc:FindFirstChildWhichIsA("BasePart")
                    if primary then
                        local dist = (primary.Position - hrp.Position).Magnitude
                        if dist <= BOMB_DETECT_DISTANCE then
                            matched = true
                            break
                        end
                    end
                end
            end
        end
        if matched then
            triggerDoubleJump()
            return true
        end
        task.wait(0.12)
    end
    return false
end

local function fireBombUnderPlayer()
    local hrp = getHRP()
    if not hrp then
        warn("CombatBombFeature: no HumanoidRootPart found")
        return
    end
    local ev, bombInstance = getBombRemote()
    if not ev then
        warn("CombatBombFeature: FakeBomb RemoteEvent not found on character")
        return
    end
    local targetPos = Vector3.new(hrp.Position.X, hrp.Position.Y - 3.5, hrp.Position.Z)
    pcall(function()
        ev:FireServer(bombInstance, targetPos)
    end)
    task.spawn(function()
        local ok = watchForBombHit(hrp, BOMB_DETECT_DURATION)
        if not ok then
            task.wait(0.18)
            triggerDoubleJump()
        end
    end)
end

local function createCombatUI()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then
        playerGui = LocalPlayer:WaitForChild("PlayerGui")
    end
    if not playerGui then return end

    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "EllipticalCombatBomb"
    screenGui.Parent = playerGui
    screenGui.ResetOnSpawn = false

    local frame = Instance.new("Frame")
    frame.Name = "CombatBombFrame"
    frame.Size = UDim2.new(0, 220, 0, 120)
    frame.Position = UDim2.new(0.5, -110, 0.7, 0)
    frame.AnchorPoint = Vector2.new(0.5, 0)
    frame.BackgroundTransparency = 0.2
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    frame.BorderSizePixel = 0
    frame.Parent = screenGui

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -10, 0, 24)
    title.Position = UDim2.new(0, 5, 0, 5)
    title.BackgroundTransparency = 1
    title.Text = "Combat - Bomb"
    title.TextColor3 = Color3.fromRGB(230, 230, 230)
    title.Font = Enum.Font.SourceSansBold
    title.TextSize = 18
    title.Parent = frame

    local bindLabel = Instance.new("TextLabel")
    bindLabel.Size = UDim2.new(0, 90, 0, 24)
    bindLabel.Position = UDim2.new(0, 6, 0, 36)
    bindLabel.BackgroundTransparency = 1
    bindLabel.Text = "Keybind:"
    bindLabel.TextColor3 = Color3.fromRGB(200,200,200)
    bindLabel.Parent = frame

    local bindBox = Instance.new("TextBox")
    bindBox.Size = UDim2.new(0, 60, 0, 26)
    bindBox.Position = UDim2.new(0, 86, 0, 34)
    bindBox.Text = DEFAULT_BIND
    bindBox.ClearTextOnFocus = false
    bindBox.Parent = frame

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 200, 0, 32)
    btn.Position = UDim2.new(0, 10, 0, 70)
    btn.Text = "Create Bomb"
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextSize = 16
    btn.BackgroundColor3 = Color3.fromRGB(70,70,70)
    btn.BorderSizePixel = 0
    btn.Parent = frame

    local currentBind = DEFAULT_BIND
    local bindKey = string.lower(DEFAULT_BIND)

    bindBox.FocusLost:Connect(function(enter)
        local txt = bindBox.Text or ""
        txt = string.sub(txt, 1, 1)
        if txt == "" then
            bindBox.Text = currentBind
            return
        end
        currentBind = txt:upper()
        bindKey = string.lower(txt)
        bindBox.Text = currentBind
    end)

    btn.MouseButton1Click:Connect(function()
        fireBombUnderPlayer()
    end)

    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            local key = input.KeyCode.Name:lower()
            if key == bindKey then
                fireBombUnderPlayer()
            end
        end
    end)
end

-- Create UI on load
pcall(function()
    createCombatUI()
end)
